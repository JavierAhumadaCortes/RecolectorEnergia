content = """# Archivos y carpetas autogenerados por Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]ser[Ss]ettings/

# Archivos de caché y configuración de IDEs (Visual Studio, VS Code, Rider)
.vs/
.idea/
.vscode/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Asegurar explícitamente que no se ignoren carpetas críticas (por si hay reglas globales)
!Assets/
!Packages/
!ProjectSettings/

# ¡Nunca ignorar los archivos .meta!
!*.meta

# Archivos de caché de builds y empaquetados
*.apk
*.aab
*.app
*.ipa
*.exe
*.dll

# Archivos ocultos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
"""

with open(".gitignore", "w", encoding="utf-8") as f:
    f.write(content)

print("Archivo .gitignore generado correctamente.")